{
  "name": "heti-kosar-web",
  "version": "0.1.0",
  "private": true,
  "description": "Heti kosár: SvelteKit PWA for the weekly meal plan, shopping list and nearby store prices.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "vite dev --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "npm run gen:api:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "gen:api": "openapi-typescript ../docs/openapi.json --default-non-nullable false --array-length -o src/lib/api/schema.d.ts",
    "gen:api:check": "npm run gen:api -- --check",
    "gen:districts": "node scripts/gen-districts.mjs",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "22.20.4",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
