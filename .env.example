# bestpricefinder configuration: every variable, with placeholders only. NEVER put real values in this file.
#
# The real file is .env.local (chmod 600, git-ignored). deploy/local/db-init.sh creates it with the database
# settings and freshly generated passwords; add any optional setting below to it by hand.
# server/bpf/config.py reads .env.local (or the file named by BPF_ENV_FILE); real environment variables win.
# Write one KEY=value per line; put comments on their own lines.

# ── database (written by deploy/local/db-init.sh) ──────────────────────────────────────────────────

# Unix socket directory of the local cluster (preferred), or a host name such as localhost.
BPF_DB_HOST=/absolute/path/to/bestpricefinder/.data/sock
# Port of the dedicated cluster.
BPF_DB_PORT=5544
# Application database.
BPF_DB_NAME=bpf
# bpf_migrator: runs db/migrations (uv run bpf-migrate). 64 hex chars from db-init.sh.
BPF_MIGRATOR_PASSWORD=<generated-by-db-init>
# bpf_ingest: daily GVH ingest and the content loader.
BPF_INGEST_PASSWORD=<generated-by-db-init>
# bpf_api: the public API (read-only).
BPF_API_PASSWORD=<generated-by-db-init>

# ── GVH Árfigyelő client (optional; defaults shown) ────────────────────────────────────────────────

# Base URL of the price API.
# BPF_GVH_BASE_URL=https://arfigyelo.gvh.hu/api
# Daily product XLSX (the client adds a cache-busting query string).
# BPF_GVH_XLSX_URL=https://cdnarfigyeloprodweu.azureedge.net/excel/arfigyelo_napi_termekadatok.xlsx
# Descriptive User-Agent sent with every request.
# BPF_GVH_USER_AGENT=bestpricefinder/0.1 (+contact: set BPF_CONTACT_EMAIL)
# Contact address for the User-Agent, so GVH can reach the operator.
# BPF_CONTACT_EMAIL=operator@example.org
# Minimum seconds between requests (must be >= 1.0: at most one request per second).
# BPF_GVH_MIN_INTERVAL_S=1.0

# ── public API (optional; defaults shown) ──────────────────────────────────────────────────────────

# Requests per minute per client IP.
# BPF_API_RATE_LIMIT_PER_MINUTE=120
# Maximum request body size in bytes.
# BPF_API_MAX_BODY_BYTES=65536
# Directory of the built SvelteKit SPA served at /.
# BPF_WEB_BUILD_DIR=/absolute/path/to/bestpricefinder/web/build
# Extra allowed CORS origins, comma-separated (empty = same origin only).
# BPF_ALLOWED_ORIGINS=https://app.example.org
# Trust X-Forwarded-For/-Proto (only when running behind your own reverse proxy).
# BPF_TRUST_PROXY_HEADERS=false
# Send Strict-Transport-Security (max-age=31536000; includeSubDomains). Only when served over TLS (Caddy).
# BPF_HSTS=false
# Serve the interactive API docs at /api/docs, /api/redoc and /api/openapi.json (development only;
# their CSP loads Swagger UI / ReDoc from cdn.jsdelivr.net). docs/openapi.json is generated without it.
# BPF_ENABLE_DOCS=false

# ── deploy/local scripts only (shell environment, NOT read from this file; defaults shown) ─────────

# Directory containing initdb/pg_ctl/postgres (PostgreSQL >= 16). Default: discovered.
# BPF_PG_BIN=/opt/homebrew/opt/postgresql@18/bin
# Cluster data directory. Log, socket, admin credentials and backups live next to it.
# BPF_PGDATA=/absolute/path/to/bestpricefinder/.data/pg
# Port used when the cluster is created.
# BPF_PG_PORT=5544
# Unix socket directory used when the cluster is created (mode 0700).
# BPF_SOCKET_DIR=/absolute/path/to/bestpricefinder/.data/sock
# Where db-init.sh writes the app credentials (also read by the server).
# BPF_ENV_FILE=/absolute/path/to/bestpricefinder/.env.local
# Backup directory for db-backup.sh.
# BPF_BACKUP_DIR=/absolute/path/to/bestpricefinder/.data/backups
# age recipient (public key age1... or recipients file): db-backup.sh then writes only encrypted dumps.
# BPF_BACKUP_AGE_RECIPIENT=age1<your-public-key>
