# /etc/caddy/Caddyfile on vm-hetikosar (deploy/azure/README.md). Adapted from deploy/local/caddy/Caddyfile.example
# (option b). :80 only answers the ACME HTTP-01 challenge and redirects to HTTPS (Caddy's automatic HTTPS); no app
# content. No access log (nothing that records visitors). No ACME e-mail.
# Private until the legal gates pass (BUILD-BRIEF §8): the NSG and the remote_ip guard below admit only
# 146.110.0.0/16. No login (removed 2026-10-15 at the owner's request).
{
	servers {
		protocols h1 h2
	}
}

hetikosar-burk.denmarkeast.cloudapp.azure.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	route {
		# Second guard behind the NSG: only the owner's user network.
		@outside not remote_ip 146.110.0.0/16
		respond @outside "Forbidden" 403 {
			close
		}
		encode zstd gzip
		request_body {
			max_size 64KiB
		}
		header {
			-Server
			-Via
		}
		reverse_proxy 127.0.0.1:8000
	}
}
