<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  bestpricefinder: the daily database backup at 03:15 (the Mac's local time, which must be Europe/Budapest;
  install-macos.sh checks it): scheduler/backup-job.sh runs db-backup.sh (age-encrypted when
  BPF_BACKUP_AGE_RECIPIENT was set at install time) and prunes old dumps.
-->
<!-- TEMPLATE: install-macos.sh fills in the placeholders and installs the result in ~/Library/LaunchAgents/.
     Do not load this file as it is. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bestpricefinder.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__BPF_REPO__/deploy/local/scheduler/backup-job.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__BPF_PATH__</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<!-- __BPF_EXTRA_ENV__ -->
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__BPF_LOG_DIR__/launchd-backup.log</string>
	<key>StandardErrorPath</key>
	<string>__BPF_LOG_DIR__/launchd-backup.log</string>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
